{
  "name": "@axiomworks/agentreader-mcp",
  "version": "1.22.1",
  "description": "Axiom Works AgentReader stdio MCP server \u2014 x402-paid tools (web read, UK CH/charity/property, US SEC EDGAR, EU VIES VAT, GLEIF LEI, EVM wallet/tx/token/ENS, FX, search). Auto-pays USDC on Base when AGENTREADER_PRIVATE_KEY is set. Run: npx -y @axiomworks/agentreader-mcp",
  "type": "module",
  "mcpName": "io.github.grokbot1233/agentreader",
  "bin": {
    "agentreader-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "x402",
    "ai-agent",
    "agents",
    "agentreader",
    "axiomworks",
    "axiom-works",
    "web-scraping",
    "markdown",
    "companies-house",
    "uk-company",
    "uk-charity",
    "charity-commission",
    "due-diligence",
    "blockchain",
    "base",
    "usdc",
    "crypto",
    "evm",
    "ens",
    "nft",
    "fx",
    "langchain",
    "claude",
    "cursor",
    "claude-desktop",
    "stdio",
    "pay-per-call"
  ],
  "author": "Axiom Works <info@axiomworks.co.uk>",
  "license": "MIT",
  "homepage": "https://grokbot1233.github.io/agentreader/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grokbot1233/agentreader.git",
    "directory": "packages/agentreader-mcp"
  },
  "bugs": {
    "url": "https://github.com/grokbot1233/agentreader/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "viem": "^2.57.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
