{
  "title": "UK New Company Leads",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "sic": { "title": "SIC code/prefix", "type": "string", "description": "e.g. 62 or 62012", "editor": "textfield" },
    "location": { "title": "Location", "type": "string", "description": "Town/city as indexed by Companies House", "editor": "textfield" },
    "postcodeArea": { "title": "Postcode area", "type": "string", "description": "e.g. M, SW, SW1", "editor": "textfield" },
    "days": { "title": "Days lookback", "type": "integer", "default": 1, "minimum": 1, "maximum": 7 },
    "withDirectors": { "title": "Include directors", "type": "boolean", "default": true },
    "limit": { "title": "Max companies", "type": "integer", "default": 25, "minimum": 1, "maximum": 100 },
    "agentreaderPrivateKey": { "title": "x402 payer key (Base USDC)", "type": "string", "isSecret": true, "description": "Funded Base wallet private key for USDC x402 settlement to api.axiomworks.co.uk" }
  }
}
