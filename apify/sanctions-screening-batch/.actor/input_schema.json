{
  "title": "Sanctions screening batch",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "names": {
      "title": "Names to screen",
      "type": "array",
      "editor": "json",
      "description": "Strings, or objects {name, type ('individual'|'entity'), country, dob or year} to sharpen scoring.",
      "prefill": [
        "BANCO NACIONAL DE CUBA",
        "Alice Wonderland"
      ]
    },
    "minScore": {
      "title": "Minimum score",
      "type": "string",
      "editor": "textfield",
      "default": "0.75",
      "description": "Only return candidates at or above this similarity (0.75-1.0). 0.75 is the AgentReader default."
    },
    "maxMatchesPerName": {
      "title": "Max candidates per name",
      "type": "integer",
      "editor": "number",
      "default": 10,
      "minimum": 1,
      "maximum": 25,
      "description": "Top-N scored candidates per name."
    },
    "maxNames": {
      "title": "Max names",
      "type": "integer",
      "editor": "number",
      "default": 1000,
      "minimum": 1,
      "maximum": 5000,
      "description": "Safety cap per run."
    }
  },
  "required": [
    "names"
  ]
}
